PORT=4000
# "local" starts a built-in MongoDB; or paste an Atlas mongodb+srv:// string
MONGODB_URI=local
MONGODB_DB=finman
# AI provider: any OpenAI-compatible chat API.
# Groq (free key at https://console.groq.com/keys):
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=qwen/qwen3.8-27b
AI_VISION_MODEL=qwen/qwen3.8-27b
# Hugging Face instead: AI_BASE_URL=https://router.huggingface.co/v1 with an hf_ token and a model it serves
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_EMAIL=
DEMO_PASSWORD=
